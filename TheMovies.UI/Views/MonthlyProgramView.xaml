<UserControl x:Class="TheMovies.UI.Views.MonthlyProgramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TheMovies.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="1000">
    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- MÅNED + BIOGRAF -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Måned"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding MonthDisplay}"
                       VerticalAlignment="Center"
                       Padding="8"/>

            <TextBlock Grid.Column="3"
                       Text="Biograf"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding Cinemas}"
                      SelectedItem="{Binding Cinema}"
                      DisplayMemberPath="Name"
                      Padding="6"/>
        </Grid>


        <!-- OPRET FORESTILLING -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="25"/>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="25"/>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="25"/>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="25"/>

                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <!-- Dato -->
            <TextBlock Grid.Column="0"
                       Text="Dato"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <DatePicker Grid.Column="1"
                        SelectedDate="{Binding Date}"/>

            <!-- Sal -->
            <TextBlock Grid.Column="3"
                       Text="Sal"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding Screens}"
                      SelectedItem="{Binding Screen}"
                      DisplayMemberPath="ScreenNumber"/>

            <!-- Film -->
            <TextBlock Grid.Column="6"
                       Text="Film"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <ComboBox Grid.Column="7"
                      ItemsSource="{Binding Movies}"
                      SelectedItem="{Binding Movie}"
                      DisplayMemberPath="Title"/>

            <!-- Starttid -->
            <TextBlock Grid.Column="9"
                       Text="Starttid"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <TextBox x:Name="StartTimeTextBox"
                     Grid.Column="10"
                     Text="{Binding StartTime, StringFormat={}{0:HH:mm}, UpdateSourceTrigger=LostFocus}"
                     Padding="6"/>

            <!-- Gem forestilling -->
            <Button Grid.Column="12"
                    Content="Gem forestilling"
                    Command="{Binding SaveShowCommand}"
                    Padding="15,8"/>
        </Grid>


        <!-- LISTE OVER FORESTILLINGER -->
        <Grid Grid.Row="4">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Liste over forestillinger"
                       FontWeight="SemiBold"/>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Shows}"
                      SelectedItem="{Binding SelectedShow}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Dato"
                                        Binding="{Binding Date, StringFormat=dd/MM/yyyy}"
                                        Width="*"/>

                    <DataGridTextColumn Header="StartTid"
                                        Binding="{Binding StartTime, StringFormat=HH:mm}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Sal"
                                        Binding="{Binding Screen.ScreenNumber}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Film"
                                        Binding="{Binding Movie.Title}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Spilletid"
                                        Binding="{Binding Movie.Duration}"
                                        Width="*"/>

                    <DataGridTextColumn Header="SlutTid"
                                        Binding="{Binding EndTime, StringFormat=HH:mm}"
                                        Width="*"/>

                </DataGrid.Columns>
            </DataGrid>

        </Grid>


        <!-- KNAPPER -->
        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Gem månedsprogram"
                    Command="{Binding SaveMonthlyProgramCommand}"
                    Padding="18,10"/>

            <Button Grid.Column="2"
                    Content="Slet forestilling"
                    Command="{Binding DeleteShowCommand}"
                    Padding="18,10"/>

            <Button Grid.Column="4"
                    Content="Afslut"
                    Command="{Binding GoBackCommand}"
                    Padding="18,10"/>

        </Grid>

    </Grid>
</UserControl>
