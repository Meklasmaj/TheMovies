<UserControl x:Class="TheMovies.UI.RegisterMovieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TheMovies.UI"
             mc:Ignorable="d" d:DesignWidth="732" Height="528">

    <Grid>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,124,0,206">

            <StackPanel Orientation="Horizontal">
                <Label Content="Titel:" Width="100" Height="34" Margin="2" Foreground="Beige"/>
                <TextBox Text="{Binding title, UpdateSourceTrigger=PropertyChanged}" 
                         Width="350" Height="34" Margin="2" Background="Beige"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Content="Genre:" Width="100" Height="34" Margin="2" Foreground="Beige"/>

                <!-- ItemSource = all the options in the dropdown -->
                <!-- SelectedItem = the currently slected Genre -->
                <ComboBox 
                          ItemsSource="{Binding Genres}" SelectedItem="{Binding MovieGenre}" 
                          Width="350" Height="34" Margin="2" Background="Beige"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Content="Duration:" Width="100" Height="34" Margin="2" Foreground="Beige"/>
                <TextBox Text="{Binding duration, UpdateSourceTrigger=PropertyChanged}"
                         Width="350" Height="34" Margin="2" Background="Beige"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Content="Director:" Width="100" Height="34" Margin="2" Foreground="Beige"/>
                <TextBox Text="{Binding movieDirector,UpdateSourceTrigger=PropertyChanged}"
                         Width="350" Height="34" Margin="2" Background="Beige"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Content="Premiere Date:" Width="100" Height="34" Margin="2" Foreground="Beige"/>
                <DatePicker SelectedDate="{Binding premiereDate, UpdateSourceTrigger=PropertyChanged}"
                            Width="350" Height="34" Margin="2" BorderThickness="0"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="290,282,0,90" Width="216">
            <Button Content="Register" 
                    Command="{Binding RegisterMovieCommand}"
                    Width="100" Height="30" Margin="5" Click="Button_Click" Background="Beige"/>

            <Button Content="Afbryd" 
                    Command="{Binding GoBackCommand}"
                    Width="100" Height="30" Margin="5" Background="Beige"/>
        </StackPanel>



    </Grid>
</UserControl>
